# demo = seeded JSON in memory (works offline, resets on restart)
# db   = Postgres (run `docker compose up -d db` and `npm run db:migrate` first)
DATA_MODE=demo

# Only used when DATA_MODE=db
DATABASE_URL=postgres://rost:rost@localhost:5432/rost

# Secret the demo partner bank uses to sign tokens for the embedded view.
# Change it outside the demo. Real partners get their own secret.
PARTNER_DEMO_SECRET=dev-secret-change-me

# Allow /api/partner/demo-token to mint a token for the stage demo.
ALLOW_DEMO_TOKEN=true

# Optional: if set, referral postbacks must send this value in the x-postback-secret header.
POSTBACK_SECRET=

# Optional: payslip photo reading (E5). Leave empty to use typed-in gross salary only.
ANTHROPIC_API_KEY=
PAYSLIP_MODEL=
