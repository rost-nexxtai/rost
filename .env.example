# Copy to .env for local Docker runs. In Dokploy, put these in the Environment tab instead.

# Required. "rost" matches existing local databases; in Dokploy use a strong, URL-safe one
# (it goes into the database URL): openssl rand -hex 24
POSTGRES_PASSWORD=rost
# Optional, defaults to rost.
# POSTGRES_USER=rost
# POSTGRES_DB=rost

# Stage helpers: demo partner token, app clock, demo reset. Defaults to false in production and true locally.
# ALLOW_DEMO_TOKEN=false

# First admin account, created on start. Set both or neither.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. When set, partners must send it in the x-postback-secret header.
POSTBACK_SECRET=

# Optional payslip photo reading.
ANTHROPIC_API_KEY=
PAYSLIP_MODEL=

# Web app security headers, fixed when the frontend image is built.
# Partner origins allowed to frame the bank view (/embed), space-separated. This site itself always may.
# EMBED_FRAME_ANCESTORS=https://app.banca.ro
# true once the domain is served over HTTPS (sends Strict-Transport-Security). Never on plain http.
# HSTS=false

# Local only: host port for the web app (default 3000).
# FRONTEND_PORT=3000
