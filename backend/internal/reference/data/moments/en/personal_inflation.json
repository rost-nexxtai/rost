{
  "id": "personal_inflation",
  "series": "News",
  "title": "Your inflation this month",
  "minutes": 2,
  "triggers": [
    "inflation_published"
  ],
  "repeatOn": [
    "inflation_published"
  ],
  "conditions": {
    "requires": [
      "spending"
    ]
  },
  "steps": [
    {
      "type": "predict",
      "question": "National inflation is {{headline}}%. What do you think yours is?",
      "answer": "personalPct",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "unit": "%",
      "start": 3
    },
    {
      "type": "reveal",
      "view": "personal_inflation"
    },
    {
      "type": "action",
      "action": "update_buffer_target",
      "title": "Keep your emergency fund worth the same",
      "body": "Raise your emergency fund target with your inflation: {{bufferTarget}} lei.",
      "options": [],
      "defaultOption": null
    }
  ],
  "followUpDays": 7
}
